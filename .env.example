# --- Shared (team spec 3.2) ---
SINGLESTORE_URL=               # unset tonight -> SQLite stub at dev/clawback.db
SENSO_API_KEY=                 # unset -> LocalPolicySource (seed/policies/*.md)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_NAME=
LLM_API_KEY=                   # unset -> rule-based fallback (offline, deterministic)
FIREDRILL_API_KEY=
DEMO_MODE=true                 # anything but exactly "false" = on
DEMO_SUPPORT_INBOX=            # teammate inbox posing as Mock Store support
DEMO_ALLOWED_RECIPIENTS=       # comma-separated EXACT addresses (support inbox + demo user)

# --- Added by Teammate B for the rehearsal (not in 3.2) ---
LLM_MODEL=claude-opus-5-5      # model id for the Anthropic SDK
DEMO_USER_EMAIL=               # u_demo's email (seed stub); must be on DEMO_ALLOWED_RECIPIENTS
EMAIL_TRANSPORT=file           # file | airbyte | gmail_api  (file = outbox/*.eml)
OUTBOX_DIR=outbox
CLAWBACK_TODAY=2026-11-20      # demo "today"; seed dates are relative to it
CLAWBACK_DB=dev/clawback.db    # SQLite stub file
CLAWBACK_BASE_URL=http://localhost:8000   # where /mock/api/* lives
SENSO_BASE_URL=                # fill in from Senso docs (see REHEARSAL_NOTES.md)
LLM_TIMEOUT_S=15               # per LLM request; on timeout/error the offline rules decide
POLICY_TIMEOUT_S=10            # wall clock per policy question; then reuse last real citation
POLICY_DIR=seed/policies       # LocalPolicySource folder
CLAWBACK_USER_ID=u_demo        # orders have no user_id; one user
CLAWBACK_NOW=                  # optional ISO datetime override of the demo clock
INBOX_READER=file              # file (inbox/*.eml) | gmail (not wired)
INBOX_DIR=inbox                # FileInboxReader folder; handled files move to processed/ignored/failed
SENSO_IDS=seed/policies/senso_ids.json   # written by dev/senso_ingest.py: content_id -> store + source URL
