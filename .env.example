SINGLESTORE_URL=
SENSO_API_KEY=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_NAME=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=       # create the template in the Persona dashboard first
PERSONA_WEBHOOK_SECRET=
SIE_URL=
SIE_API_KEY=
ARCEE_API_KEY=
LLM_API_KEY=
EMBEDDING_DIM=1024         # match the SIE model
AMPLITUDE_API_KEY=
FIREDRILL_API_KEY=
PACT_SIGNING_KEY=          # random 32+ bytes, never committed; read at call time
MOCK_WEBHOOK_SECRET=
DEMO_MODE=true             # anything but "false" = on
DEMO_SUPPORT_INBOX=        # teammate inbox posing as Mock Store support
DEMO_ALLOWED_RECIPIENTS=   # comma-separated EXACT addresses (support inbox + demo user's email)

# ---- Optional, added by Part C (not in section 3.2; every one has a safe default) ----
BACKEND_URL=http://localhost:8000          # where the mock store sends its price webhook
AMPLITUDE_DASHBOARD_URL=                   # link shown on the Under the hood Analytics panel
AMPLITUDE_REGION=                          # "eu" if your Amplitude project is in the EU data center
NEXT_PUBLIC_API_URL=http://localhost:8000  # frontend -> backend (frontend/.env.local); "/backend" through a tunnel
DEMO_TODAY=2026-11-20                      # the mock store's "today" for return windows
CORS_EXTRA_ORIGINS=                        # comma-separated extra browser origins (e.g. a tunnel URL)
STRICT_ROUTERS=false                       # true = crash on startup if a mounted router fails to import
LOG_LEVEL=INFO
ALLOW_REMOTE_ADMIN=                        # true = serve /mock/admin and /debug/* to non-local devices too (default: laptop only)
ANALYTICS_LOG=                             # event log file for today's counts ("off" disables; default .analytics_events.jsonl)

# ---- Added by Teammate B (agent, policy, actions); every one has a safe default ----
LLM_MODEL=claude-opus-5-5      # model id for the Anthropic SDK
DEMO_USER_EMAIL=               # u_demo's email (seed stub); must be on DEMO_ALLOWED_RECIPIENTS
EMAIL_TRANSPORT=file           # file | airbyte | gmail_api  (file = outbox/*.eml)
OUTBOX_DIR=outbox
CLAWBACK_TODAY=2026-11-20      # demo "today"; seed dates are relative to it
CLAWBACK_DB=dev/clawback.db    # SQLite stub file
CLAWBACK_BASE_URL=http://localhost:8000   # where /mock/api/* lives
SENSO_BASE_URL=                # fill in from Senso docs (see REHEARSAL_NOTES.md)

# ---- Added by Siva ----
CLAWBACK_API_BASE=http://localhost:8000    # where the scheduler calls POST /opportunities/{id}/propose
